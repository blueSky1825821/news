# Copy this file to backend/.env and restart the backend after changes.
# Comma-separated email addresses of administrator accounts.
ADMIN_EMAILS=

# Required in production: use a random secret of at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Current platform and unverified subscription account settings.
PUBLIC_BASE_URL=http://q7banlife.me/news
WECHAT_OAUTH_ENABLED=false
WECHAT_MASS_SEND_ENABLED=false
# Optional absolute path to an installed Chromium or Chrome executable.
# WECHAT_BROWSER_EXECUTABLE=/usr/bin/google-chrome

# SMTP configuration for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI新闻播报 <noreply@example.com>
APP_BASE_URL=http://localhost:3000

# CCTV news text collection, Beijing time. Stops retrying for the day after a successful run.
XINWENLIANBO_ENABLED=true
# XINWENLIANBO_CRON=* 19-23 * * *

# Structured API, RSS and scheduler logs: debug, info, warn, error, silent.
LOG_LEVEL=info

# Investment analysis in CCTV article details. Keys stay on the backend.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
# Additional OpenAI-compatible Chat Completions models. Omit apiKeyEnv for an unauthenticated local service.
# XINWENLIANBO_LLM_MODELS='[{"id":"research","label":"研究模型","model":"YOUR_MODEL_ID","baseUrl":"https://YOUR_PROVIDER/v1","apiKeyEnv":"RESEARCH_LLM_API_KEY"}]'
# RESEARCH_LLM_API_KEY=
# Generate automatically after collection. Leave unset for manual generation only.
# XINWENLIANBO_AUTO_ANALYSIS_MODEL=deepseek:deepseek-flash
