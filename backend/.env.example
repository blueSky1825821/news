# Copy this file to backend/.env and restart the backend after changes.
# Comma-separated email addresses of administrator accounts.
ADMIN_EMAILS=

# Required in production: use a random secret of at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Current platform and unverified subscription account settings.
PUBLIC_BASE_URL=http://q7banlife.me/news
WECHAT_OAUTH_ENABLED=false
WECHAT_MASS_SEND_ENABLED=false

# SMTP configuration for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI新闻播报 <noreply@example.com>
APP_BASE_URL=http://localhost:3000

# Whisper.cpp configuration for xinwenlianbo audio transcription.
# WHISPER_EXECUTABLE: path to whisper-cli binary. If no '/' is present, it is treated as a command name on PATH.
#   Default: /opt/whisper.cpp/build/bin/whisper-cli (managed install) or whisper-cli found on PATH.
# WHISPER_MODEL_PATH: path to the ggml model file (e.g. ggml-base-q5_1.bin).
#   Default: /opt/whisper.cpp/models/ggml-base-q5_1.bin (managed install).
WHISPER_EXECUTABLE=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-base-q5_1.bin
